// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Classification {
  id        Int      @id @default(autoincrement())
  question  String
  response  String
  createdAt DateTime @default(now())
}

// Client Model
model Client {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  companyName String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // WhatsApp API Credentials
  whatsappAccessToken   String?
  whatsappPhoneNumberId String?
  whatsappBusinessId    String?

  // Onboarding status
  onboardingCompleted Boolean @default(false)

  // Relations to agent-specific configurations
  contactConfig   ContactConfig[]
  historyConfig   HistoryConfig[]
  memoryConfig    MemoryConfig[]
  pricingConfig   PricingConfig[]
  servicesConfig  ServicesConfig[]
  smalltalkConfig SmalltalkConfig[]
  users           User[] // Relation to User model
  whatsappNumbers WhatsappNumber[] // Relation to WhatsappNumber model
}

// WhatsappNumber Model for mapping WhatsApp phone numbers to clients
model WhatsappNumber {
  id          String   @id @default(uuid())
  phoneNumber String   @unique
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// User Model for SaaS platform authentication
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String // Hashed password
  name      String
  role      String   @default("user") // e.g., "admin", "user"
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Agent-specific configuration models
model ContactConfig {
  id       String @id @default(uuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  contactSuggestion String // e.g., "acesse os botões de contato na pagina"
  agentDescription  String // e.g., "direcionar o usuário para os botões de contatos"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HistoryConfig {
  id       String @id @default(uuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  companyHistory   String // The entire history text
  agentDescription String // e.g., "tirar dúvidas sobre a história profissional sobre a agência que cria soluções tecnologicas..."

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MemoryConfig {
  id       String @id @default(uuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  memoryGuidelines String // The general tone and guidelines for memory-related responses
  agentDescription String // e.g., "tirar dúvidas sobre conversas anteriores..."

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PricingConfig {
  id       String @id @default(uuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  paymentMethods    String // e.g., "Os projetos podem ser cobrados por hora ou de forma fechada..."
  agentDescription  String // e.g., "fornecer respostas sobre formas de pagamento da agencia..."
  noPricingInfoText String // e.g., "Nunca forneça valores ou estimativas. Apenas direcione..."

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServicesConfig {
  id       String @id @default(uuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  servicesOffered   String // The entire list of technologies, focus areas, and services
  agentDescription  String // e.g., "tirar dúvidas sobre os serviços oferecidos pela agência..."
  conversationStyle String? // e.g., "Essa conversa já foi iniciada antes, então evite coisas como..."

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SmalltalkConfig {
  id       String @id @default(uuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  smalltalkGuidelines String // The tone, humor level, and specific instructions for small talk
  agentDescription    String // e.g., "fazer o primeiro contato com os clientes da agencia..."

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
